diff --git a/src/Orders/OrderService.cs b/src/Orders/OrderService.cs
index 71ad210..3c6fd11 100644
--- a/src/Orders/OrderService.cs
+++ b/src/Orders/OrderService.cs
@@ -18,3 +18,12 @@ public sealed class OrderService
         return await repository.GetAsync(orderId, cancellationToken);
     }
+
+    public async Task CancelAsync(Guid orderId, CancellationToken cancellationToken)
+    {
+        var order = await repository.GetAsync(orderId, cancellationToken);
+        if (order.Status is not (OrderStatus.Placed or OrderStatus.Paid))
+            throw new InvalidOperationException("Only Placed or Paid orders can be cancelled.");
+
+        await repository.MarkCancelledAsync(orderId, cancellationToken);
+    }
 }
