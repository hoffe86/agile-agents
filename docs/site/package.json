{
  "name": "agile-agents-docs",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "project": "node scripts/project.mjs",
    "start": "docusaurus start --host 127.0.0.1",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.52.3",
    "@mdx-js/react": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "playwright": "1.65.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.4"
  }
}
