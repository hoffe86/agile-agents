        <mxCell id="recheck-note" value="[After an edit] Lead reruns the applicable gates on the changed content." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fontSize=14;fillColor=#fff8e5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="240" y="950" width="550" height="28" as="geometry"/></mxCell>
        <mxCell id="rereview" value="[Checks pass] Send fresh evidence and findings for re-review" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="1007" as="sourcePoint"/><mxPoint x="826" y="1007" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="fresh-verdict" value="Fresh independent verdict and remaining findings" style="html=1;dashed=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="826" y="1039" as="sourcePoint"/><mxPoint x="265" y="1039" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="reconcile" value="Lead reconciles original criteria with actual delivery and evidence. A budget check accompanies each closed window and completion." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fillColor=#dafbe1;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="290" y="1056" width="550" height="44" as="geometry"/></mxCell>
