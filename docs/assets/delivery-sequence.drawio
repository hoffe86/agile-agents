        <mxCell id="design-note" value="[Design gate triggered] The lead also obtains the human's design decision before implementation." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fillColor=#fff8e5;fontColor=#633c00;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="455" height="46" as="geometry"/></mxCell>
        <mxCell id="implementation" value="6–7  Implement and verify" style="html=1;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fillColor=#ddf4ff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="6" y="608" width="893" height="24" as="geometry"/></mxCell>
        <mxCell id="dispatch" value="[Delegated] One dependency-ready task" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="662" as="sourcePoint"/><mxPoint x="639" y="662" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="author-return" value="Worker hand-off and task evidence" style="html=1;dashed=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="639" y="696" as="sourcePoint"/><mxPoint x="265" y="696" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bar-note" value="[Direct author] Lead records equivalent evidence, no worker hand-off.&lt;br&gt;After all tasks: run applicable combined gates; [opt-in] verify the dev deployment." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacingLeft=9;fontSize=14;fillColor=#fff8e5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="240" y="713" width="580" height="56" as="geometry"/></mxCell>
        <mxCell id="end" value="8–9  Independent review and completion" style="html=1;align=left;spacingLeft=8;fontStyle=1;fontSize=14;fillColor=#fbefff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="6" y="783" width="893" height="24" as="geometry"/></mxCell>
        <mxCell id="review-request" value="Requirement, readable change, current gate results and task evidence" style="html=1;verticalAlign=bottom;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=14;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="837" as="sourcePoint"/><mxPoint x="826" y="837" as="targetPoint"/></mxGeometry></mxCell>
