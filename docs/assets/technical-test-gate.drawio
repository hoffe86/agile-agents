<mxfile host="agile-agents" type="device">
  <diagram name="Technical test gate" id="technical-test-gate">
    <mxGraphModel grid="0" page="1" pageScale="1" pageWidth="790" pageHeight="610" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="What runs before independent review?" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="18" y="10" width="730" height="36" as="geometry"/></mxCell>
        <mxCell id="sub" value="Example commands from this repository. Other solutions declare their own." style="text;html=1;align=left;fontSize=14;fontColor=#424a53;" vertex="1" parent="1"><mxGeometry x="18" y="48" width="730" height="25" as="geometry"/></mxCell>
        <mxCell id="lead" value="&lt;b&gt;dev-lead&lt;/b&gt;&lt;br&gt;Identify the combined change; invoke one runner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ddf4ff;strokeColor=#0969da;" vertex="1" parent="1"><mxGeometry x="18" y="86" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="runner" value="&lt;b&gt;run-gate.sh or run-gate.ps1&lt;/b&gt;&lt;br&gt;Resolve the profile and enabled checks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ddf4ff;strokeColor=#0969da;" vertex="1" parent="1"><mxGeometry x="18" y="187" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="profile" value="&lt;b&gt;.github/solution-profile.yaml&lt;/b&gt;&lt;br&gt;quality_gates.test_bar and testing.smoke" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f6f8fa;strokeColor=#57606a;" vertex="1" parent="1"><mxGeometry x="433" y="187" width="324" height="66" as="geometry"/></mxCell>
        <mxCell id="checks" value="&lt;b&gt;Run configured commands in order&lt;/b&gt;&lt;br&gt;python scripts/run-repo-checks.py lint&lt;br&gt;python scripts/run-repo-checks.py unit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff1d0;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="18" y="288" width="360" height="81" as="geometry"/></mxCell>
        <mxCell id="smoke" value="&lt;b&gt;Smoke: start, probe, clean up&lt;/b&gt;&lt;br&gt;npm run start --prefix docs/site -- --port 3030&lt;br&gt;Check the configured loopback URL" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff1d0;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="18" y="402" width="360" height="81" as="geometry"/></mxCell>
        <mxCell id="results" value="&lt;b&gt;Runner evidence&lt;/b&gt;&lt;br&gt;Check records + exit status: 0 pass/skip,&lt;br&gt;1 failure, 2 configuration gap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f6f8fa;strokeColor=#57606a;" vertex="1" parent="1"><mxGeometry x="433" y="402" width="324" height="81" as="geometry"/></mxCell>
        <mxCell id="decide" value="&lt;b&gt;dev-lead checks results and freshness&lt;/b&gt;&lt;br&gt;Record the run-level gate_check with&lt;br&gt;emit-event.sh or emit-event.ps1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#ddf4ff;strokeColor=#0969da;" vertex="1" parent="1"><mxGeometry x="433" y="288" width="324" height="81" as="geometry"/></mxCell>
        <mxCell id="outcomes" value="&lt;b&gt;Dispatch review only on current, admissible evidence.&lt;/b&gt; Fix failed work or missing setup first. A script exit or event does not supply human consent or a reviewer verdict." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;spacingRight=14;fontSize=15;fillColor=#fbefff;strokeColor=#8250df;" vertex="1" parent="1"><mxGeometry x="18" y="525" width="739" height="60" as="geometry"/></mxCell>
        <mxCell id="failure-edge" value="configuration gap or check failure" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#cf222e;exitX=0.25;exitY=0;entryX=0.8;entryY=0;" edge="1" parent="1" source="runner" target="decide"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="108" y="167"/><mxPoint x="768" y="167"/><mxPoint x="768" y="270"/><mxPoint x="692" y="270"/></Array></mxGeometry></mxCell>
        <mxCell id="call" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="lead" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="config" value="inputs" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="profile" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="exec" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="runner" target="checks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="advance" value="applicable checks pass" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="checks" target="smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="report" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="smoke" target="results"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="return" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#57606a;" edge="1" parent="1" source="results" target="decide"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
